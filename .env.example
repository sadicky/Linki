# ==============================================================================
# Linki SaaS Food Delivery - Variables d'environnement
# ==============================================================================

# Supabase Public
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private (Service Role pour les opérations administratives/webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode Démo / Fallback (active les données et simulations temps réel si les clés ne sont pas encore configurées)
NEXT_PUBLIC_DEMO_MODE=true
